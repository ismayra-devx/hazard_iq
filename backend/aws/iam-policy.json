{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HazardIQDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/HazardIQ-Reports",
        "arn:aws:dynamodb:*:*:table/HazardIQ-Reports/*",
        "arn:aws:dynamodb:*:*:table/HazardIQ_Hotspots",
        "arn:aws:dynamodb:*:*:table/HazardIQ_Hotspots/*"
      ]
    },
    {
      "Sid": "HazardIQS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::hazardiq-hazard-photos*"
    },
    {
      "Sid": "HazardIQS3ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::hazardiq-hazard-photos*/*"
    },
    {
      "Sid": "HazardIQBedrockVisionAccess",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:Converse",
        "bedrock:ListFoundationModels"
      ],
      "Resource": "*"
    },
    {
      "Sid": "HazardIQCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
