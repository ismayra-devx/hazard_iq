# ==============================================================================
# HazardIQ Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS (Comma-separated list of allowed origins)
# For local development with Vite: http://localhost:5173,http://127.0.0.1:5173
# For AWS Amplify deployment: https://main.d123456abcdef.amplifyapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Weather API (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_REQUEST_TIMEOUT_SECONDS=5.0

# Safety & Risk Thresholds
DEFAULT_CITY=Delhi
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090

# Citizen Hazard Reports & Upload Restrictions
MAX_IMAGE_SIZE_BYTES=5242880

# Storage & Database Flags
# Set to 'true' in staging/production when AWS DynamoDB is configured
ENABLE_DYNAMODB=false
DYNAMODB_TABLE_REPORTS=HazardIQ-Reports
LOCAL_STORAGE_PATH=data/local_reports.json

# Amazon S3 Photo Storage
ENABLE_S3=false
S3_BUCKET_PHOTOS=hazardiq-hazard-photos

# Amazon Bedrock AI Integration (Amazon Nova Lite)
# Set to 'true' only when AWS credentials & model access are verified
ENABLE_BEDROCK=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_SECONDS=10.0

# Cedar Policy Engine Configuration
CEDAR_POLICY_PATH=app/policies/cedar_policy.cedar
